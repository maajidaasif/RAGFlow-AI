# ============================================================
# RAGFlow AI — Backend Environment Variables
# ============================================================
#
# HOW TO USE
# ----------
# 1. Copy this file to .env (same folder):
#       cp .env.example .env          (macOS / Linux)
#       copy .env.example .env        (Windows)
#
# 2. Generate secure random values for each key below:
#       python -c "import secrets; print(secrets.token_hex(32))"
#    Run that command twice — once for SECRET_KEY, once for
#    JWT_SECRET_KEY — and paste the output into .env.
#
# 3. NEVER commit .env to Git. It is already in .gitignore.
# 4. NEVER share or log the actual key values.
# ============================================================


# Flask session signing key.
# Must be a cryptographically random string (min 32 bytes).
SECRET_KEY=your-secret-key-here


# Flask-JWT-Extended signing key.
# Must be a cryptographically random string (min 32 bytes).
JWT_SECRET_KEY=your-jwt-secret-key-here


# Enable Flask debug mode for LOCAL DEVELOPMENT ONLY.
# Set to "true" to enable the interactive debugger and auto-reloader.
# NEVER set this to "true" in production — it exposes an interactive
# Python shell that can be used to execute arbitrary code on the server.
# Omit this variable (or set to "false") in all production environments.
# FLASK_DEBUG=true
